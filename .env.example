# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# URL pública del servicio (la de Cloud Run) usada para registrar el webhook de Telegram
# Ejemplo: https://bet-tracker-bot-xxxxx-uc.a.run.app
PUBLIC_URL=

# Ruta secreta del webhook (cualquier cadena aleatoria, se usa como parte de la URL)
WEBHOOK_SECRET_PATH=

# Puerto interno del servidor (Cloud Run lo inyecta automáticamente como PORT)
PORT=8080

# API key de Gemini (Google AI Studio: https://aistudio.google.com/apikey), usada para leer los tickets por foto
GEMINI_API_KEY=
