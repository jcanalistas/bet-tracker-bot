# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=

# URL pública del servicio (la de Cloud Run) usada para registrar el webhook de Telegram
# Ejemplo: https://bet-tracker-bot-xxxxx-uc.a.run.app
PUBLIC_URL=

# Ruta secreta del webhook (cualquier cadena aleatoria, se usa como parte de la URL)
WEBHOOK_SECRET_PATH=

# Puerto interno del servidor (Cloud Run lo inyecta automáticamente como PORT)
PORT=8080

# API key de Gemini (Google AI Studio: https://aistudio.google.com/apikey), usada para leer los tickets por foto
GEMINI_API_KEY=

# ID numérico de Telegram del dueño del bot (consíguelo hablando con @userinfobot).
# Es el único autorizado a usar /premium_on y /premium_off para activar/desactivar
# premium a otros usuarios a mano, mientras no haya pasarela de pago.
OWNER_TELEGRAM_ID=

# API key de The Odds API (the-odds-api.com), para el comparador de cuotas
# tras registrar un ticket. Opcional: si se deja vacía, el comparador
# simplemente no se ejecuta (el resto del bot funciona igual).
ODDS_API_KEY=

# Cobro automático de Premium (Stripe). Las tres opcionales a propósito: sin
# ellas, "⭐ Premium" cae al mensaje de activación manual de siempre.
# - STRIPE_SECRET_KEY: clave secreta (sk_test_... o sk_live_...) del Dashboard de Stripe.
# - STRIPE_WEBHOOK_SECRET: firma (whsec_...) del endpoint /webhooks/stripe, se consigue
#   al crear el endpoint en el Dashboard (Developers > Webhooks) DESPUÉS de desplegar.
# - STRIPE_PRICE_ID: ID del precio recurrente mensual (price_...) creado en el Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Username del bot de Telegram (sin @), para volver al chat tras pagar en
# Stripe Checkout. Opcional: sin él, se usa PUBLIC_URL como destino de vuelta.
TELEGRAM_BOT_USERNAME=

# Cadena aleatoria que protege /internal/check-reminders (lo llama Cloud
# Scheduler una vez al día para avisar de apuestas pendientes). Opcional:
# si se deja vacía, el endpoint no funciona y no se envían recordatorios.
REMINDER_SECRET=
